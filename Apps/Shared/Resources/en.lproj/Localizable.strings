/*
  Lisa's notification text (plan §6.5, §6.7, NOTIFY-06). The host's push payload carries only these localization
  keys: aps.alert title-loc-key is <CATEGORY>_TITLE, loc-key is <CATEGORY>_BODY, or <CATEGORY>_BODY_TITLED with the
  item's truncated title as %@ when this device opted in to "show titles". The text is generic and never contains the
  owner's content. Action titles and the placeholders shown when previews are hidden are registered at launch.
*/

/* Reminder: an upcoming confirmed deadline. */
"LISA_REMINDER_TITLE" = "Reminder";
"LISA_REMINDER_BODY" = "Something you planned is coming up.";
"LISA_REMINDER_BODY_TITLED" = "%@ is coming up.";
"LISA_REMINDER_HIDDEN_PREVIEW" = "A reminder from Lisa";

/* Overdue: a confirmed task past its deadline. */
"LISA_OVERDUE_TITLE" = "Past due";
"LISA_OVERDUE_BODY" = "A task is past its deadline.";
"LISA_OVERDUE_BODY_TITLED" = "%@ is past its deadline.";
"LISA_OVERDUE_HIDDEN_PREVIEW" = "A task past its deadline";

/* Plan block: an accepted block of the plan is about to start. */
"LISA_PLAN_BLOCK_TITLE" = "Up next";
"LISA_PLAN_BLOCK_BODY" = "A planned block is about to start.";
"LISA_PLAN_BLOCK_BODY_TITLED" = "Up next: %@";
"LISA_PLAN_BLOCK_HIDDEN_PREVIEW" = "A planned block";

/* Event proposal: an event Lisa found that waits for review in the app. */
